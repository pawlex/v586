# Matches sim/Makefile's `clean` target ($(OBJDIR) v586_tb.vcd)
obj_dir/
v586_tb.vcd

# Matches sim/rom/Makefile's `clean` target ($(OUTPUT) $(HEXOUT)) --
# the .hex images are intentionally committed (so the sim and the test
# suite run without needing nasm), so only the .bin intermediates are
# ignored here.
rom/boot.bin
rom/tests/*.bin
